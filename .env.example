# OCR engine
OCR_LANGUAGE=en
OCR_DEVICE=cpu

# Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Image quality thresholds (optional overrides)
# MIN_DIMENSION_PX=400
# BLUR_THRESHOLD=50
# DARK_THRESHOLD=60
# BRIGHT_THRESHOLD=220